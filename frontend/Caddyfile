{
	admin off
	auto_https off
}

:{$PORT} {
	encode zstd gzip

	# Django: the API, the admin site and the admin's static files.
	@django path /api/* /admin /admin/* /static/*
	handle @django {
		reverse_proxy {$BACKEND_URL} {
			header_up X-Forwarded-Proto https
		}
	}

	# Built files are named by content hash, so they can be cached for good.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else is the single-page app.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
